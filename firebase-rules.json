{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !data.child('meta/host').exists() || data.child('meta/host').val() === auth.uid)",
        ".validate": "$code.length === 4",
        "meta": {
          "host": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "guesses": {
          "$round": {
            "$pid": {
              ".write": "auth != null && $pid === auth.uid",
              ".validate": "newData.child('raised').isNumber() && newData.child('goal').isNumber()"
            }
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && (newData.child('pid').val() === auth.uid || newData.child('pid').val() === 'host')) || (data.exists() && data.child('by').val() === auth.uid && (!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('pid').val() === data.child('pid').val()))))",
            ".validate": "newData.hasChildren(['pid', 'at'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "r": {
              "$name": {
                "$uid": {
                  ".write": "auth != null && $uid === auth.uid",
                  ".validate": "newData.isString() && newData.val().length <= 40"
                }
              }
            }
          }
        }
      }
    },
    "boards": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('games/' + $code + '/meta/host').val() === auth.uid",
        ".validate": "$code.length === 4",
        "pens": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || (!data.exists() && root.child('penkeys/' + newData.child('k').val() + '/room').val() === $code && root.child('penkeys/' + newData.child('k').val() + '/exp').val() > now))",
            ".validate": "newData.hasChildren(['k', 'n']) && newData.child('n').isString() && newData.child('n').val().length <= 60"
          }
        },
        "view": {
          ".write": "auth != null && root.child('boards/' + $code + '/pens/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['r', 'x', 'y', 'w', 'h'])"
        },
        "ink": {
          ".write": "auth != null && root.child('boards/' + $code + '/pens/' + auth.uid).exists()",
          "$round": {
            "$key": {
              ".validate": "newData.hasChildren(['p']) && $key.length <= 24"
            }
          }
        },
        "cmd": {
          ".write": "auth != null && root.child('boards/' + $code + '/pens/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['do', 'n']) && newData.child('do').isString() && newData.child('do').val().length <= 12"
        }
      }
    },
    "penkeys": {
      "$k": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : (newData.child('host').val() === auth.uid && root.child('games/' + newData.child('room').val() + '/meta/host').val() === auth.uid))",
        ".validate": "$k.length === 6 && newData.hasChildren(['room', 'host', 'exp']) && newData.child('exp').isNumber() && newData.child('exp').val() <= now + 3600000"
      }
    },
    "users": {
      "$uid": {
        "chats": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
          "$code": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (auth.uid === $uid ? !newData.exists() : root.child('saves/' + $code + '/crew/members/' + auth.uid).exists())",
            ".validate": "$code.length === 6 && newData.child('by').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 60"
          }
        },
        "crews": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
          "$code": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
            ".validate": "$code.length === 6"
          }
        },
        "devices": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
          "$dev": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
            ".validate": "$dev.length <= 24 && newData.child('pub').isString() && newData.child('pub').val().length <= 200"
          }
        }
      }
    },
    "saves": {
      "$code": {
        ".validate": "$code.length === 6",
        "crew": {
          "meta": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && newData.exists() && (!data.exists() || root.child('saves/' + $code + '/crew/members/' + auth.uid).exists())",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 400",
            "theme": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "nick": {
              "$uid": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              }
            },
            "pic": {
              ".validate": "newData.isString() && newData.val().length <= 60000 && (newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('e2ee:v1:'))"
            },
            "photo": {
              ".validate": "newData.hasChildren(['img', 'a', 'b', 't'])",
              "img": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "a": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "b": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "t": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
              },
              "dark": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "bg": {
              ".validate": "newData.hasChildren(['img'])",
              "img": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "fr": {
                ".validate": "newData.hasChildren(['x', 'y', 'w', 'h', 'iw', 'ih'])",
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "w": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "h": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "iw": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20000"
                },
                "ih": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20000"
                },
                "$other": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "pf": {
              ".validate": "newData.hasChildren(['x', 'y', 'w', 'h', 'iw', 'ih'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "w": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "h": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "iw": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20000"
              },
              "ih": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 20000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "members": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (($uid === auth.uid && data.exists()) || ($uid === auth.uid && root.child('saves/' + $code + '/crew/meta').exists() && ((!root.child('saves/' + $code + '/crew/members').exists() && !root.child('saves/' + $code + '/crew/chat').exists()) || root.child('users/' + auth.uid + '/chats/' + $code).exists())) || (root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !data.exists() && root.child('saves/' + $code + '/crew/requests/' + $uid).exists()) || (root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !newData.exists()))",
              ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 400",
              "a": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "p": {
                ".validate": "newData.isString() && newData.val().length <= 20000 && (newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('e2ee:v1:'))"
              },
              "r": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "pv": {
                ".validate": "newData.isNumber()"
              },
              "c": {
                ".validate": "newData.isNumber()"
              },
              ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid"
            }
          },
          "chat": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$msg": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid && newData.child('pid').val() === auth.uid) || (data.exists() && data.child('by').val() === auth.uid && (!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('pid').val() === data.child('pid').val()))))",
              ".validate": "newData.hasChildren(['pid', 'at'])",
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 12000"
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "r": {
                "$name": {
                  "$uid": {
                    ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
                    ".validate": "newData.isString() && newData.val().length <= 400"
                  }
                }
              }
            }
          },
          "push": {
            "$uid": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (($uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()) || (root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !newData.exists()))",
              ".validate": "!newData.child('sub/endpoint').exists() || (newData.child('sub/endpoint').isString() && newData.child('sub/endpoint').val().beginsWith('https://') && newData.child('sub/endpoint').val().length <= 1000)"
            }
          },
          "pushSent": {},
          "typing": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()"
            }
          },
          "media": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$id": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && data.child('by').val() === auth.uid && (!newData.exists() || newData.child('by').val() === auth.uid)))",
              ".validate": "newData.child('d').isString() && newData.child('d').val().length <= 2400000 && (newData.child('d').val().matches(/^data:image\\/(jpeg|png|gif|webp);base64,/) || newData.child('d').val().beginsWith('e2ee:v1:'))"
            },
            ".indexOn": [
              "by"
            ]
          },
          "$other": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()"
          },
          "here": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
            ".validate": "newData.val() === true"
          },
          "requests": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && auth.uid === $uid",
              ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && ($uid === auth.uid || (root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !newData.exists()))",
              ".validate": "newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 40"
            }
          },
          "keyv": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "keys": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$kid": {
              "$uid": {
                ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !newData.exists()",
                "$dev": {
                  ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && !data.exists() && root.child('saves/' + $code + '/crew/members/' + $uid).exists() && root.child('users/' + $uid + '/devices/' + $dev).exists()",
                  ".validate": "newData.child('e').isString() && newData.child('e').val().length <= 200 && newData.child('w').isString() && newData.child('w').val().length <= 200"
                }
              }
            }
          }
        },
        "$other": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
