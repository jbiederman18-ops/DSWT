{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !data.child('meta/host').exists() || data.child('meta/host').val() === auth.uid)",
        ".validate": "$code.length === 4",
        "meta": {
          "host": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && $pid === auth.uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "guesses": {
          "$round": {
            "$pid": {
              ".write": "auth != null && $pid === auth.uid",
              ".validate": "newData.child('raised').isNumber() && newData.child('goal').isNumber()"
            }
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && (newData.child('pid').val() === auth.uid || newData.child('pid').val() === 'host')) || (data.exists() && data.child('by').val() === auth.uid && (!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('pid').val() === data.child('pid').val()))))",
            ".validate": "newData.hasChildren(['pid', 'at'])",
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "r": {
              "$name": {
                "$uid": {
                  ".write": "auth != null && $uid === auth.uid",
                  ".validate": "newData.isString() && newData.val().length <= 40"
                }
              }
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        "chats": {
          ".read": "auth != null && auth.uid === $uid",
          "$code": {
            ".write": "auth != null && (auth.uid === $uid ? !newData.exists() : (newData.exists() && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()))",
            ".validate": "$code.length === 6 && newData.child('by').val() === auth.uid && newData.child('n').isString() && newData.child('n').val().length <= 60"
          }
        }
      }
    },
    "saves": {
      "$code": {
        ".validate": "$code.length === 6",
        "crew": {
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && newData.exists() && (!data.exists() || root.child('saves/' + $code + '/crew/members/' + auth.uid).exists())",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 60",
            "theme": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "icon": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "nick": {
              "$uid": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              }
            }
          },
          "members": {
            ".read": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && (($uid === auth.uid && root.child('saves/' + $code + '/crew/meta').exists()) || (!newData.exists() && $uid.length < 12 && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()))",
              ".validate": "newData.child('n').isString() && newData.child('n').val().length <= 40",
              "a": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "c": {
                ".validate": "newData.isNumber()"
              }
            }
          },
          "chat": {
            ".read": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$msg": {
              ".write": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid && (newData.child('pid').val() === auth.uid || newData.child('pid').val() === 'host')) || (data.exists() && data.child('by').val() === auth.uid && (!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('pid').val() === data.child('pid').val()))))",
              ".validate": "newData.hasChildren(['pid', 'at'])",
              "t": {
                ".validate": "newData.isString() && newData.val().length <= 2000"
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "r": {
                "$name": {
                  "$uid": {
                    ".write": "auth != null && $uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
                    ".validate": "newData.isString() && newData.val().length <= 40"
                  }
                }
              }
            }
          },
          "push": {
            "$uid": {
              ".write": "auth != null && (($uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()) || (!newData.exists() && $uid.length < 12 && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()))",
              ".validate": "!newData.child('sub/endpoint').exists() || (newData.child('sub/endpoint').isString() && newData.child('sub/endpoint').val().beginsWith('https://') && newData.child('sub/endpoint').val().length <= 1000)"
            }
          },
          "pushSent": {},
          "typing": {
            ".read": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()"
            }
          },
          "media": {
            ".read": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            "$id": {
              ".write": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('by').val() === auth.uid))",
              ".validate": "newData.child('d').isString() && newData.child('d').val().length <= 1700000 && newData.child('d').val().matches(/^data:image\\/(jpeg|png|gif|webp);base64,/)"
            }
          },
          "$other": {
            ".read": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()",
            ".write": "auth != null && root.child('saves/' + $code + '/crew/members/' + auth.uid).exists()"
          }
        },
        "$other": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
